{
  "name": "Teriyaki Salmon",
  "meal_type": "Dinner",
  "servings": 4,
  "prep_time": "10 minutes",
  "cook_time": "15 minutes",
  "macros_per_serving": {
    "calories": 420,
    "protein_g": 38,
    "carbs_g": 22,
    "fat_g": 18
  },
  "ingredients": [
    {
      "amount": "4 fillets",
      "item": "salmon (6 oz each)",
      "store_section": "Meat/Seafood"
    },
    {
      "amount": "1/4 cup",
      "item": "soy sauce",
      "store_section": "Pantry/Dry Goods"
    },
    {
      "amount": "2 tbsp",
      "item": "honey",
      "store_section": "Pantry/Dry Goods"
    },
    {
      "amount": "1 tbsp",
      "item": "rice vinegar",
      "store_section": "Pantry/Dry Goods"
    },
    {
      "amount": "1 tbsp",
      "item": "sesame oil",
      "store_section": "Pantry/Dry Goods"
    },
    {
      "amount": "3 cloves",
      "item": "garlic, minced",
      "store_section": "Produce"
    },
    {
      "amount": "1 tsp",
      "item": "fresh ginger, grated",
      "store_section": "Produce"
    },
    {
      "amount": "1 tbsp",
      "item": "cornstarch",
      "store_section": "Pantry/Dry Goods"
    },
    {
      "amount": "2 tbsp",
      "item": "green onions, sliced",
      "store_section": "Produce"
    },
    {
      "amount": "1 tsp",
      "item": "sesame seeds",
      "store_section": "Pantry/Dry Goods"
    }
  ],
  "instructions": [
    "Whisk soy sauce, honey, rice vinegar, sesame oil, garlic, ginger, and cornstarch together.",
    "Heat an oven-safe skillet over medium-high heat with a little oil.",
    "Sear salmon skin-side up for 3 minutes. Flip and pour sauce over fillets.",
    "Transfer to a 400\u00b0F oven and bake 8-10 minutes until cooked through.",
    "Spoon pan sauce over salmon. Garnish with green onions and sesame seeds.",
    "Serve over steamed rice or vegetables."
  ],
  "substitutions": {
    "dairy_free": "Already dairy-free.",
    "gluten_free": "Use tamari or coconut aminos instead of soy sauce.",
    "low_carb": "Serve over cauliflower rice and reduce honey to 1 tsp."
  }
}