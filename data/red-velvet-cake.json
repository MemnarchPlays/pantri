{
  "name": "Red Velvet Cake",
  "meal_type": "Desserts",
  "servings": 12,
  "prep_time": "25 minutes",
  "cook_time": "35 minutes",
  "macros_per_serving": {
    "calories": 440,
    "protein_g": 5,
    "carbs_g": 62,
    "fat_g": 20
  },
  "ingredients": [
    {
      "amount": "2.5 cups",
      "item": "all-purpose flour",
      "store_section": "Pantry/Dry Goods"
    },
    {
      "amount": "1.5 cups",
      "item": "granulated sugar",
      "store_section": "Pantry/Dry Goods"
    },
    {
      "amount": "2 tbsp",
      "item": "unsweetened cocoa powder",
      "store_section": "Pantry/Dry Goods"
    },
    {
      "amount": "1 tsp",
      "item": "baking soda",
      "store_section": "Pantry/Dry Goods"
    },
    {
      "amount": "1 tsp",
      "item": "salt",
      "store_section": "Pantry/Dry Goods"
    },
    {
      "amount": "2 large",
      "item": "eggs",
      "store_section": "Dairy/Eggs"
    },
    {
      "amount": "1.5 cups",
      "item": "vegetable oil",
      "store_section": "Pantry/Dry Goods"
    },
    {
      "amount": "1 cup",
      "item": "buttermilk",
      "store_section": "Dairy/Eggs"
    },
    {
      "amount": "2 tbsp",
      "item": "red food coloring",
      "store_section": "Pantry/Dry Goods"
    },
    {
      "amount": "1 tsp",
      "item": "white vinegar",
      "store_section": "Pantry/Dry Goods"
    },
    {
      "amount": "1 tsp",
      "item": "vanilla extract",
      "store_section": "Pantry/Dry Goods"
    },
    {
      "amount": "8 oz",
      "item": "cream cheese, softened",
      "store_section": "Dairy/Eggs"
    },
    {
      "amount": "4 tbsp",
      "item": "butter, softened",
      "store_section": "Dairy/Eggs"
    },
    {
      "amount": "2 cups",
      "item": "powdered sugar",
      "store_section": "Pantry/Dry Goods"
    }
  ],
  "instructions": [
    "Preheat oven to 350\u00b0F. Grease and flour two 9-inch round cake pans.",
    "Whisk flour, sugar, cocoa powder, baking soda, and salt.",
    "Beat oil, eggs, buttermilk, food coloring, vinegar, and vanilla together.",
    "Combine wet and dry until smooth.",
    "Divide between pans. Bake 30-35 minutes until toothpick comes out clean.",
    "Cool completely.",
    "Beat cream cheese and butter until fluffy. Add powdered sugar and beat until smooth.",
    "Frost between layers and over the outside of the cake."
  ],
  "substitutions": {
    "dairy_free": "Use dairy-free buttermilk (plant milk + 1 tbsp vinegar) and dairy-free cream cheese.",
    "gluten_free": "Use a 1:1 gluten-free flour blend."
  }
}