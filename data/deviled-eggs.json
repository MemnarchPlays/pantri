{
  "name": "Deviled Eggs",
  "meal_type": "Snacks",
  "servings": 12,
  "prep_time": "15 minutes",
  "cook_time": "12 minutes",
  "macros_per_serving": {
    "calories": 120,
    "protein_g": 8,
    "carbs_g": 2,
    "fat_g": 9
  },
  "ingredients": [
    {
      "amount": "12 large",
      "item": "eggs",
      "store_section": "Dairy/Eggs"
    },
    {
      "amount": "1/4 cup",
      "item": "mayonnaise",
      "store_section": "Pantry/Dry Goods"
    },
    {
      "amount": "1 tbsp",
      "item": "Dijon mustard",
      "store_section": "Pantry/Dry Goods"
    },
    {
      "amount": "1 tbsp",
      "item": "apple cider vinegar",
      "store_section": "Pantry/Dry Goods"
    },
    {
      "amount": "1/4 tsp",
      "item": "paprika plus more for garnish",
      "store_section": "Pantry/Dry Goods"
    },
    {
      "amount": "to taste",
      "item": "salt and pepper",
      "store_section": "Pantry/Dry Goods"
    },
    {
      "amount": "optional",
      "item": "bacon crumbles and chives",
      "store_section": "Meat/Seafood"
    }
  ],
  "instructions": [
    "Place eggs in a pot and cover with cold water by 1 inch.",
    "Bring to a boil, then cover and remove from heat. Let sit 10-12 minutes.",
    "Transfer to an ice bath for 10 minutes. Peel carefully.",
    "Halve eggs lengthwise. Pop yolks into a bowl.",
    "Mash yolks with mayo, mustard, vinegar, paprika, salt, and pepper until smooth.",
    "Pipe or spoon filling back into egg white halves.",
    "Garnish with paprika and optional bacon or chives."
  ],
  "substitutions": {
    "dairy_free": "Already dairy-free.",
    "gluten_free": "Already gluten-free."
  },
  "notes": "Older eggs peel more easily than fresh eggs for hard boiling."
}