{
  "name": "Spicy Tuna Rice Bowl",
  "meal_type": "Lunch",
  "servings": 2,
  "prep_time": "10 minutes",
  "cook_time": "20 minutes",
  "macros_per_serving": {
    "calories": 420,
    "protein_g": 32,
    "carbs_g": 48,
    "fat_g": 10
  },
  "ingredients": [
    {
      "amount": "2 pouches",
      "item": "tuna in water (2.6 oz each)",
      "store_section": "Pantry/Dry Goods"
    },
    {
      "amount": "1 cup",
      "item": "jasmine rice, dry",
      "store_section": "Pantry/Dry Goods"
    },
    {
      "amount": "2 tbsp",
      "item": "mayonnaise",
      "store_section": "Pantry/Dry Goods"
    },
    {
      "amount": "1 tbsp",
      "item": "sriracha",
      "store_section": "Pantry/Dry Goods"
    },
    {
      "amount": "1 tbsp",
      "item": "soy sauce",
      "store_section": "Pantry/Dry Goods"
    },
    {
      "amount": "1",
      "item": "avocado, sliced",
      "store_section": "Produce"
    },
    {
      "amount": "1/2 cup",
      "item": "cucumber, diced",
      "store_section": "Produce"
    },
    {
      "amount": "2 tbsp",
      "item": "green onions, chopped",
      "store_section": "Produce"
    },
    {
      "amount": "1 tsp",
      "item": "sesame seeds",
      "store_section": "Pantry/Dry Goods"
    }
  ],
  "instructions": [
    "Cook rice according to package directions.",
    "Drain tuna and mix with mayonnaise and sriracha until combined.",
    "Drizzle cooked rice with soy sauce and stir to coat.",
    "Divide rice between 2 bowls. Top with spicy tuna, avocado, and cucumber.",
    "Garnish with green onions and sesame seeds."
  ],
  "substitutions": {
    "dairy_free": "Already dairy-free.",
    "gluten_free": "Use tamari instead of soy sauce.",
    "low_carb": "Replace rice with cauliflower rice."
  }
}