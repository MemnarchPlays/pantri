{
  "name": "Funnel Cake",
  "meal_type": "Desserts",
  "servings": 4,
  "prep_time": "10 minutes",
  "cook_time": "15 minutes",
  "macros_per_serving": {
    "calories": 380,
    "protein_g": 6,
    "carbs_g": 52,
    "fat_g": 16
  },
  "ingredients": [
    {
      "amount": "2 cups",
      "item": "all-purpose flour",
      "store_section": "Pantry/Dry Goods"
    },
    {
      "amount": "2 tbsp",
      "item": "granulated sugar",
      "store_section": "Pantry/Dry Goods"
    },
    {
      "amount": "1 tsp",
      "item": "baking powder",
      "store_section": "Pantry/Dry Goods"
    },
    {
      "amount": "1/2 tsp",
      "item": "salt",
      "store_section": "Pantry/Dry Goods"
    },
    {
      "amount": "2 large",
      "item": "eggs",
      "store_section": "Dairy/Eggs"
    },
    {
      "amount": "1.5 cups",
      "item": "milk",
      "store_section": "Dairy/Eggs"
    },
    {
      "amount": "1 tsp",
      "item": "vanilla extract",
      "store_section": "Pantry/Dry Goods"
    },
    {
      "amount": "oil",
      "item": "for frying",
      "store_section": "Pantry/Dry Goods"
    },
    {
      "amount": "1/2 cup",
      "item": "powdered sugar for dusting",
      "store_section": "Pantry/Dry Goods"
    }
  ],
  "instructions": [
    "Whisk flour, sugar, baking powder, and salt.",
    "In another bowl, beat eggs, milk, and vanilla.",
    "Combine wet and dry until smooth batter forms.",
    "Heat 2 inches of oil to 375\u00b0F in a wide skillet.",
    "Pour batter through a funnel or squeeze bottle in circular and criss-cross patterns.",
    "Fry 2 minutes per side until golden brown. Drain on paper towels.",
    "Dust generously with powdered sugar. Serve immediately."
  ],
  "substitutions": {
    "dairy_free": "Use oat milk.",
    "gluten_free": "Use a 1:1 gluten-free flour blend.",
    "vegan": "Use plant milk and flax eggs."
  }
}