{
  "name": "Loaded Queso Dip",
  "meal_type": "Snacks",
  "servings": 8,
  "prep_time": "10 minutes",
  "cook_time": "15 minutes",
  "macros_per_serving": {
    "calories": 240,
    "protein_g": 12,
    "carbs_g": 14,
    "fat_g": 16
  },
  "ingredients": [
    {
      "amount": "1 lb",
      "item": "Velveeta or American cheese, cubed",
      "store_section": "Dairy/Eggs"
    },
    {
      "amount": "1/2 lb",
      "item": "ground beef or chorizo",
      "store_section": "Meat/Seafood"
    },
    {
      "amount": "1 can",
      "item": "Rotel diced tomatoes with chiles (10 oz)",
      "store_section": "Pantry/Dry Goods"
    },
    {
      "amount": "1/4 cup",
      "item": "milk",
      "store_section": "Dairy/Eggs"
    },
    {
      "amount": "1 tsp",
      "item": "cumin",
      "store_section": "Pantry/Dry Goods"
    },
    {
      "amount": "1 tsp",
      "item": "chili powder",
      "store_section": "Pantry/Dry Goods"
    },
    {
      "amount": "tortilla chips",
      "item": "for serving",
      "store_section": "Pantry/Dry Goods"
    }
  ],
  "instructions": [
    "Brown ground beef in a skillet. Drain fat. Season with cumin and chili powder.",
    "In a saucepan over low heat, melt Velveeta with milk, stirring frequently.",
    "Stir in Rotel tomatoes (with juice) and cooked meat.",
    "Stir until fully combined and smooth.",
    "Transfer to a slow cooker on warm setting to keep hot while serving.",
    "Serve with tortilla chips."
  ],
  "substitutions": {
    "gluten_free": "Serve with gluten-free chips.",
    "vegetarian": "Skip the meat and add black beans instead."
  }
}