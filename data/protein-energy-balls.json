{
  "name": "Protein Energy Balls",
  "meal_type": "Snacks",
  "servings": 12,
  "prep_time": "15 minutes",
  "cook_time": "0 minutes",
  "macros_per_serving": {
    "calories": 180,
    "protein_g": 8,
    "carbs_g": 22,
    "fat_g": 8
  },
  "ingredients": [
    {
      "amount": "1 cup",
      "item": "rolled oats",
      "store_section": "Pantry/Dry Goods"
    },
    {
      "amount": "1/2 cup",
      "item": "peanut butter",
      "store_section": "Pantry/Dry Goods"
    },
    {
      "amount": "1/3 cup",
      "item": "honey",
      "store_section": "Pantry/Dry Goods"
    },
    {
      "amount": "1/2 cup",
      "item": "chocolate chips",
      "store_section": "Pantry/Dry Goods"
    },
    {
      "amount": "1 scoop",
      "item": "protein powder",
      "store_section": "Pantry/Dry Goods"
    },
    {
      "amount": "2 tbsp",
      "item": "chia seeds",
      "store_section": "Pantry/Dry Goods"
    },
    {
      "amount": "1 tsp",
      "item": "vanilla extract",
      "store_section": "Pantry/Dry Goods"
    }
  ],
  "instructions": [
    "Combine all ingredients in a large bowl. Mix until fully combined.",
    "Refrigerate the mixture for 30 minutes to firm up.",
    "Roll into 12 equal balls using your hands.",
    "Store in an airtight container in the refrigerator."
  ],
  "substitutions": {
    "dairy_free": "Use dairy-free chocolate chips.",
    "gluten_free": "Use certified gluten-free oats.",
    "vegan": "Replace honey with maple syrup and use plant-based protein powder.",
    "low_carb": "Replace oats with almond flour and honey with 2 tbsp allulose."
  },
  "notes": "Keeps refrigerated up to 1 week. Freeze for up to 3 months."
}