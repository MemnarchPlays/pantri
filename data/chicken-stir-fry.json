  "ingredients": [
    {
      "amount": "1.5 lbs",
      "item": "chicken breast, sliced thin",
      "store_section": "Meat/Seafood"
    },
    {
      "amount": "2 cups",
      "item": "broccoli florets",
      "store_section": "Produce"
    },
    {
      "amount": "1 cup",
      "item": "snap peas",
      "store_section": "Produce"
    },
    {
      "amount": "1 medium",
      "item": "zucchini, sliced",
      "store_section": "Produce"
    },
    {
      "amount": "1 cup",
      "item": "carrots, julienned",
      "store_section": "Produce"
    },
    {
      "amount": "3 cloves",
      "item": "garlic, minced",
      "store_section": "Produce"
    },
    {
      "amount": "1 tbsp",
      "item": "fresh ginger, grated",
      "store_section": "Produce"
    },
    {
      "amount": "3 tbsp",
      "item": "soy sauce",
      "store_section": "Pantry/Dry Goods"
    },
    {
      "amount": "1 tbsp",
      "item": "oyster sauce",
      "store_section": "Pantry/Dry Goods"
    },
    {
      "amount": "1 tbsp",
      "item": "sesame oil",
      "store_section": "Pantry/Dry Goods"
    },
    {
      "amount": "2 tbsp",
      "item": "vegetable oil",
      "store_section": "Pantry/Dry Goods"
    },
    {
      "amount": "1 tbsp",
      "item": "cornstarch",
      "store_section": "Pantry/Dry Goods"
    }
  ],
  "instructions": [
    "Toss chicken slices with cornstarch, salt, and pepper.",
    "Heat vegetable oil in a wok or large skillet over high heat until smoking.",
    "Cook chicken in batches, 3-4 minutes until golden. Remove and set aside.",
    "Add more oil if needed. Stir fry carrots and broccoli 3 minutes.",
    "Add bell pepper, snap peas, garlic, and ginger. Cook 2 more minutes.",
    "Return chicken. Add soy sauce, oyster sauce, and sesame oil. Toss to coat.",
    "Serve immediately over steamed rice."
  ],
  "substitutions": {
    "dairy_free": "Already dairy-free.",
    "gluten_free": "Use tamari instead of soy sauce and gluten-free oyster sauce.",
    "low_carb": "Serve over cauliflower rice.",
    "vegetarian": "Replace chicken with tofu or tempeh and skip oyster sauce."
  }
}