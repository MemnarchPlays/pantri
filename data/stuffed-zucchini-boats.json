{
  "name": "Stuffed Zucchini Boats",
  "meal_type": "Dinner",
  "servings": 4,
  "prep_time": "15 minutes",
  "cook_time": "30 minutes",
  "macros_per_serving": {
    "calories": 320,
    "protein_g": 22,
    "carbs_g": 18,
    "fat_g": 18
  },
  "ingredients": [
    {
      "amount": "4 large",
      "item": "zucchini",
      "store_section": "Produce"
    },
    {
      "amount": "1 lb",
      "item": "ground beef or Italian sausage",
      "store_section": "Meat/Seafood"
    },
    {
      "amount": "1 large",
      "item": "onion, diced",
      "store_section": "Produce"
    },
    {
      "amount": "3 cloves",
      "item": "garlic, minced",
      "store_section": "Produce"
    },
    {
      "amount": "1/2 cup",
      "item": "marinara sauce",
      "store_section": "Pantry/Dry Goods"
    },
    {
      "amount": "1 cup",
      "item": "shredded mozzarella",
      "store_section": "Dairy/Eggs"
    },
    {
      "amount": "1/4 cup",
      "item": "grated parmesan",
      "store_section": "Dairy/Eggs"
    },
    {
      "amount": "1 tsp",
      "item": "Italian seasoning",
      "store_section": "Pantry/Dry Goods"
    },
    {
      "amount": "2 tbsp",
      "item": "olive oil",
      "store_section": "Pantry/Dry Goods"
    },
    {
      "amount": "to taste",
      "item": "salt and pepper",
      "store_section": "Pantry/Dry Goods"
    }
  ],
  "instructions": [
    "Preheat oven to 400\u00b0F.",
    "Halve zucchini lengthwise. Scoop out flesh, leaving a 1/4-inch shell. Chop flesh and set aside.",
    "Brush zucchini shells with olive oil, season, and bake cut-side down 10 minutes.",
    "Brown meat with onion and garlic. Add chopped zucchini flesh and cook 3 minutes.",
    "Stir in marinara, Italian seasoning, salt, and pepper.",
    "Fill zucchini shells with meat mixture. Top with mozzarella and parmesan.",
    "Bake 15-18 minutes until cheese is bubbly and golden."
  ],
  "substitutions": {
    "dairy_free": "Use dairy-free cheese.",
