  },
  "ingredients": [
    {
      "amount": "2 lbs",
      "item": "chicken thighs, boneless, cubed",
      "store_section": "Meat/Seafood"
    },
    {
      "amount": "1/2 cup",
      "item": "cornstarch",
      "store_section": "Pantry/Dry Goods"
    },
    {
      "amount": "2 large",
      "item": "eggs, beaten",
      "store_section": "Dairy/Eggs"
    },
    {
      "amount": "oil",
      "item": "for frying",
      "store_section": "Pantry/Dry Goods"
    },
    {
      "amount": "3/4 cup",
      "item": "orange juice",
      "store_section": "Beverages"
    },
    {
      "amount": "1/4 cup",
      "item": "soy sauce",
      "store_section": "Pantry/Dry Goods"
    },
    {
      "amount": "3 tbsp",
      "item": "honey",
      "store_section": "Pantry/Dry Goods"
    },
    {
      "amount": "2 tbsp",
      "item": "brown sugar",
      "store_section": "Pantry/Dry Goods"
    },
    {
      "amount": "1 tbsp",
      "item": "orange zest",
      "store_section": "Produce"
    },
    {
      "amount": "3 cloves",
      "item": "garlic, minced",
      "store_section": "Produce"
    },
    {
      "amount": "1 tsp",
      "item": "fresh ginger, grated",
      "store_section": "Produce"
    },
    {
      "amount": "1 tbsp",
      "item": "cornstarch mixed with 2 tbsp water",
      "store_section": "Pantry/Dry Goods"
    }
  ],
  "instructions": [
    "Dip chicken in beaten egg then toss in cornstarch to coat.",
    "Fry in 2 inches of oil at 375\u00b0F until golden and crispy, about 4-5 minutes. Drain.",
    "Whisk orange juice, soy sauce, honey, brown sugar, zest, garlic, and ginger in a saucepan.",
    "Bring to a simmer over medium heat. Add cornstarch slurry and stir until thickened.",
    "Toss fried chicken in orange sauce immediately before serving.",
    "Serve over steamed rice with sesame seeds and green onions."
  ],
  "substitutions": {
    "gluten_free": "Use tamari and gluten-free cornstarch.",
    "dairy_free": "Already dairy-free.",
    "low_carb": "Serve over cauliflower rice and reduce orange juice to 1/4 cup."
  }
}