  "ingredients": [
    {
      "amount": "1 lb",
      "item": "spaghetti",
      "store_section": "Pantry/Dry Goods"
    },
    {
      "amount": "1 lb",
      "item": "ground beef",
      "store_section": "Meat/Seafood"
    },
    {
      "amount": "1/2 lb",
      "item": "ground pork",
      "store_section": "Meat/Seafood"
    },
    {
      "amount": "1 large",
      "item": "onion, finely diced",
      "store_section": "Produce"
    },
    {
      "amount": "2",
      "item": "carrots, finely diced",
      "store_section": "Produce"
    },
    {
      "amount": "2 stalks",
      "item": "celery, finely diced",
      "store_section": "Produce"
    },
    {
      "amount": "4 cloves",
      "item": "garlic, minced",
      "store_section": "Produce"
    },
    {
      "amount": "1.5 cups",
      "item": "beef broth",
      "store_section": "Pantry/Dry Goods"
    },
    {
      "amount": "1/2 cup",
      "item": "heavy cream",
      "store_section": "Dairy/Eggs"
    },
    {
      "amount": "1/2 cup",
      "item": "whole milk",
      "store_section": "Dairy/Eggs"
    },
    {
      "amount": "1/4 cup",
      "item": "dry red wine",
      "store_section": "Beverages"
    },
    {
      "amount": "2 tbsp",
      "item": "olive oil",
      "store_section": "Pantry/Dry Goods"
    },
    {
      "amount": "1/2 cup",
      "item": "grated parmesan",
      "store_section": "Dairy/Eggs"
    }
  ],
  "instructions": [
    "Heat olive oil in a large heavy pot. Saut\u00e9 onion, carrots, and celery 8 minutes.",
    "Add garlic and cook 1 minute.",
    "Add ground beef and pork. Cook until browned, breaking up the meat.",
    "Pour in wine and cook until evaporated, 3 minutes.",
    "Add beef broth. Stir well and bring to a simmer.",
    "Stir in milk and heavy cream.",
    "Reduce heat to low and simmer uncovered 45 minutes, stirring occasionally.",
    "Season with salt and pepper. Serve over spaghetti topped with parmesan."
  ],
  "substitutions": {
    "dairy_free": "Skip milk and parmesan, use a splash of beef broth instead.",
    "gluten_free": "Use gluten-free pasta.",
    "low_carb": "Serve sauce over zucchini noodles or spaghetti squash.",
    "vegetarian": "Use lentils and mushrooms instead of meat."
  },
  "notes": "White bolognese \u2014 rich and creamy without tomatoes. Equally delicious."
}