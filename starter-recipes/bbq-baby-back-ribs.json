{
  "name": "BBQ Baby Back Ribs",
  "meal_type": "Dinner",
  "servings": 4,
  "prep_time": "15 minutes",
  "cook_time": "3 hours 30 minutes",
  "macros_per_serving": {
    "calories": 680,
    "protein_g": 48,
    "carbs_g": 22,
    "fat_g": 42
  },
  "ingredients": [
    {
      "amount": "2 racks",
      "item": "baby back pork ribs",
      "store_section": "Meat/Seafood"
    },
    {
      "amount": "1 cup",
      "item": "BBQ sauce",
      "store_section": "Pantry/Dry Goods"
    },
    {
      "amount": "2 tbsp",
      "item": "brown sugar",
      "store_section": "Pantry/Dry Goods"
    },
    {
      "amount": "2 tbsp",
      "item": "smoked paprika",
      "store_section": "Pantry/Dry Goods"
    },
    {
      "amount": "1 tbsp",
      "item": "garlic powder",
      "store_section": "Pantry/Dry Goods"
    },
    {
      "amount": "1 tbsp",
      "item": "onion powder",
      "store_section": "Pantry/Dry Goods"
    },
    {
      "amount": "1 tsp",
      "item": "cayenne pepper",
      "store_section": "Pantry/Dry Goods"
    },
    {
      "amount": "to taste",
      "item": "salt and black pepper",
      "store_section": "Pantry/Dry Goods"
    }
  ],
  "instructions": [
    "Preheat oven to 275\u00b0F.",
    "Remove membrane from back of ribs by sliding a knife under it and pulling off.",
    "Mix brown sugar, paprika, garlic powder, onion powder, cayenne, salt, and pepper.",
    "Rub dry rub generously over both sides of ribs.",
    "Wrap tightly in foil and bake 3 hours.",
    "Unwrap ribs. Brush generously with BBQ sauce on both sides.",
    "Broil or grill 5-10 minutes until sauce is caramelized. Rest 5 minutes before cutting."
  ],
  "substitutions": {
    "dairy_free": "Already dairy-free.",
    "gluten_free": "Use gluten-free BBQ sauce.",
    "low_carb": "Use sugar-free BBQ sauce and skip the brown sugar."
  },
  "notes": "Low and slow is the secret. Don't rush the 3-hour oven cook."
}