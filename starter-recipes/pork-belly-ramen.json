  "instructions": [
    "Score pork belly skin. Roast skin-side up at 300\u00b0F for 2 hours until very tender. Rest 15 minutes.",
    "Slice pork belly into 1/2-inch rounds. Sear in a hot pan until caramelized.",
    "Bring broth, soy sauce, mirin, garlic, and ginger to a simmer for 20 minutes.",
    "Whisk miso paste into broth. Add sesame oil.",
    "Cook ramen noodles according to package directions.",
    "Soft boil eggs: 6.5 minutes in boiling water, then ice bath. Peel and halve.",
    "Assemble bowls: noodles, broth, pork belly slices, egg, green onions, and nori."
  ],
  "substitutions": {
