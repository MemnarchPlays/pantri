{
  "name": "Chicken Parmesan",
  "meal_type": "Dinner",
  "servings": 4,
  "prep_time": "15 minutes",
  "cook_time": "30 minutes",
  "macros_per_serving": {
    "calories": 580,
    "protein_g": 48,
    "carbs_g": 38,
    "fat_g": 22
  },
  "ingredients": [
    {
      "amount": "4",
      "item": "chicken breasts, pounded thin",
      "store_section": "Meat/Seafood"
    },
    {
      "amount": "1 cup",
      "item": "Italian breadcrumbs",
      "store_section": "Pantry/Dry Goods"
    },
    {
      "amount": "1/2 cup",
      "item": "grated parmesan",
      "store_section": "Dairy/Eggs"
    },
    {
      "amount": "2 large",
      "item": "eggs, beaten",
      "store_section": "Dairy/Eggs"
    },
    {
      "amount": "1/2 cup",
      "item": "all-purpose flour",
      "store_section": "Pantry/Dry Goods"
    },
    {
      "amount": "1.5 cups",
      "item": "marinara sauce",
      "store_section": "Pantry/Dry Goods"
    },
    {
      "amount": "1.5 cups",
      "item": "shredded mozzarella",
      "store_section": "Dairy/Eggs"
    },
    {
      "amount": "3 tbsp",
      "item": "olive oil",
      "store_section": "Pantry/Dry Goods"
    },
    {
      "amount": "to taste",
      "item": "salt and pepper",
      "store_section": "Pantry/Dry Goods"
    }
  ],
  "instructions": [
    "Preheat oven to 400\u00b0F.",
    "Set up a breading station: flour, beaten eggs, breadcrumbs mixed with parmesan.",
    "Season chicken with salt and pepper. Coat in flour, then egg, then breadcrumb mixture.",
    "Heat olive oil in an oven-safe skillet. Fry chicken 3-4 minutes per side until golden.",
    "Top each piece with marinara sauce and mozzarella.",
    "Transfer to oven and bake 15-18 minutes until cheese is bubbly and chicken is cooked through.",
    "Serve over spaghetti or with garlic bread."
  ],
  "substitutions": {
    "dairy_free": "Use dairy-free breadcrumbs and mozzarella.",
    "gluten_free": "Use gluten-free breadcrumbs and flour.",
    "low_carb": "Use crushed pork rinds instead of breadcrumbs."
  }
}