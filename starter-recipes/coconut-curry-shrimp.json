{
  "name": "Coconut Curry Shrimp",
  "meal_type": "Dinner",
  "servings": 4,
  "prep_time": "10 minutes",
  "cook_time": "20 minutes",
  "macros_per_serving": {
    "calories": 380,
    "protein_g": 28,
    "carbs_g": 28,
    "fat_g": 16
  },
  "ingredients": [
    {
      "amount": "1.5 lbs",
      "item": "large shrimp, peeled and deveined",
      "store_section": "Meat/Seafood"
    },
    {
      "amount": "1 can",
      "item": "coconut milk (13.5 oz)",
      "store_section": "Pantry/Dry Goods"
    },
    {
      "amount": "1 large",
      "item": "onion, diced",
      "store_section": "Produce"
    },
    {
      "amount": "4 cloves",
      "item": "garlic, minced",
      "store_section": "Produce"
    },
    {
      "amount": "1 tbsp",
      "item": "fresh ginger, grated",
      "store_section": "Produce"
    },
    {
      "amount": "2 tbsp",
      "item": "red curry paste",
      "store_section": "Pantry/Dry Goods"
    },
    {
      "amount": "1 tbsp",
      "item": "fish sauce",
      "store_section": "Pantry/Dry Goods"
    },
    {
      "amount": "1 tbsp",
      "item": "brown sugar",
      "store_section": "Pantry/Dry Goods"
    },
    {
      "amount": "1 tbsp",
      "item": "coconut oil",
      "store_section": "Pantry/Dry Goods"
    },
    {
      "amount": "fresh",
      "item": "cilantro and lime for serving",
      "store_section": "Produce"
    }
  ],
  "instructions": [
    "Heat coconut oil in a large skillet over medium heat.",
    "Saute onion 5 minutes. Add garlic and ginger, cook 1 minute.",
    "Add curry paste and stir 1 minute until fragrant.",
    "Pour in coconut milk. Stir in fish sauce and brown sugar.",
    "Simmer 8 minutes until sauce thickens slightly.",
    "Add shrimp and cook 3-4 minutes until pink and cooked through.",
    "Serve over jasmine rice with cilantro and lime wedges."
  ],
  "substitutions": {
    "dairy_free": "Already dairy-free.",
    "gluten_free": "Use gluten-free fish sauce or coconut aminos.",
    "low_carb": "Serve over cauliflower rice.",
    "vegetarian": "Replace shrimp with chickpeas and extra vegetables."
  }
}