{
  "name": "Carrot Cake",
  "meal_type": "Desserts",
  "servings": 12,
  "prep_time": "20 minutes",
  "cook_time": "35 minutes",
  "macros_per_serving": {
    "calories": 420,
    "protein_g": 5,
    "carbs_g": 58,
    "fat_g": 20
  },
  "ingredients": [
    {
      "amount": "2 cups",
      "item": "all-purpose flour",
      "store_section": "Pantry/Dry Goods"
    },
    {
      "amount": "2 cups",
      "item": "granulated sugar",
      "store_section": "Pantry/Dry Goods"
    },
    {
      "amount": "2 tsp",
      "item": "baking soda",
      "store_section": "Pantry/Dry Goods"
    },
    {
      "amount": "2 tsp",
      "item": "cinnamon",
      "store_section": "Pantry/Dry Goods"
    },
    {
      "amount": "1 tsp",
      "item": "salt",
      "store_section": "Pantry/Dry Goods"
    },
    {
      "amount": "4 large",
      "item": "eggs",
      "store_section": "Dairy/Eggs"
    },
    {
      "amount": "1 cup",
      "item": "vegetable oil",
      "store_section": "Pantry/Dry Goods"
    },
    {
      "amount": "3 cups",
      "item": "carrots, freshly grated",
      "store_section": "Produce"
    },
    {
      "amount": "8 oz",
      "item": "cream cheese, softened",
      "store_section": "Dairy/Eggs"
    },
    {
      "amount": "4 tbsp",
      "item": "butter, softened",
      "store_section": "Dairy/Eggs"
    },
    {
      "amount": "2 cups",
      "item": "powdered sugar",
      "store_section": "Pantry/Dry Goods"
    },
    {
      "amount": "1 tsp",
      "item": "vanilla extract",
      "store_section": "Pantry/Dry Goods"
    }
  ],
  "instructions": [
    "Preheat oven to 350\u00b0F. Grease two 9-inch round cake pans.",
    "Whisk flour, sugar, baking soda, cinnamon, and salt.",
    "In another bowl, beat eggs, oil, and vanilla. Fold in grated carrots.",
    "Combine wet and dry ingredients until just mixed.",
    "Divide between pans and bake 30-35 minutes until a toothpick comes out clean.",
    "Cool completely.",
    "Beat cream cheese and butter until fluffy. Add powdered sugar and vanilla. Beat until smooth.",
    "Frost cake with cream cheese frosting."
  ],
  "substitutions": {
    "dairy_free": "Use dairy-free cream cheese and butter for the frosting.",
    "gluten_free": "Use a 1:1 gluten-free flour blend.",
    "vegan": "Use flax eggs and dairy-free cream cheese."
  }
}