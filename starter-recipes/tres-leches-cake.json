{
  "name": "Tres Leches Cake",
  "meal_type": "Desserts",
  "servings": 12,
  "prep_time": "20 minutes",
  "cook_time": "30 minutes",
  "macros_per_serving": {
    "calories": 380,
    "protein_g": 8,
    "carbs_g": 52,
    "fat_g": 16
  },
  "ingredients": [
    {
      "amount": "1 cup",
      "item": "all-purpose flour",
      "store_section": "Pantry/Dry Goods"
    },
    {
      "amount": "1.5 tsp",
      "item": "baking powder",
      "store_section": "Pantry/Dry Goods"
    },
    {
      "amount": "1/4 tsp",
      "item": "salt",
      "store_section": "Pantry/Dry Goods"
    },
    {
      "amount": "5 large",
      "item": "eggs, separated",
      "store_section": "Dairy/Eggs"
    },
    {
      "amount": "1 cup",
      "item": "granulated sugar",
      "store_section": "Pantry/Dry Goods"
    },
    {
      "amount": "1/3 cup",
      "item": "whole milk",
      "store_section": "Dairy/Eggs"
    },
    {
      "amount": "1 tsp",
      "item": "vanilla extract",
      "store_section": "Pantry/Dry Goods"
    },
    {
      "amount": "1 can",
      "item": "sweetened condensed milk (14 oz)",
      "store_section": "Pantry/Dry Goods"
    },
    {
      "amount": "1 can",
      "item": "evaporated milk (12 oz)",
      "store_section": "Pantry/Dry Goods"
    },
    {
      "amount": "1 cup",
      "item": "heavy cream",
      "store_section": "Dairy/Eggs"
    },
    {
      "amount": "2 cups",
      "item": "heavy cream for topping",
      "store_section": "Dairy/Eggs"
    },
    {
      "amount": "3 tbsp",
      "item": "powdered sugar",
      "store_section": "Pantry/Dry Goods"
    }
  ],
  "instructions": [
    "Preheat oven to 350\u00b0F. Grease a 9x13 pan.",
    "Beat egg yolks and sugar until pale and thick. Mix in milk and vanilla.",
    "Fold in flour, baking powder, and salt.",
    "Beat egg whites to stiff peaks. Gently fold into batter in thirds.",
    "Bake 25-30 minutes until a toothpick comes out clean. Cool completely.",
    "Mix condensed milk, evaporated milk, and 1 cup heavy cream. Poke holes in cake.",
    "Pour three-milk mixture slowly over cake. Refrigerate 4 hours or overnight.",
    "Whip remaining cream with powdered sugar to stiff peaks. Spread over cake before serving."
  ],
  "substitutions": {
    "dairy_free": "Use coconut condensed milk, coconut evaporated milk, and coconut cream.",
    "gluten_free": "Use a 1:1 gluten-free flour blend."
  },
  "notes": "The longer it soaks, the better. Overnight is ideal."
}