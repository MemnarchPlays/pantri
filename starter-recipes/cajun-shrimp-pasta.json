{
  "name": "Cajun Shrimp Pasta",
  "meal_type": "Dinner",
  "servings": 4,
  "prep_time": "10 minutes",
  "cook_time": "20 minutes",
  "macros_per_serving": {
    "calories": 520,
    "protein_g": 32,
    "carbs_g": 56,
    "fat_g": 18
  },
  "ingredients": [
    {
      "amount": "1 lb",
      "item": "large shrimp, peeled and deveined",
      "store_section": "Meat/Seafood"
    },
    {
      "amount": "12 oz",
      "item": "penne or fettuccine pasta",
      "store_section": "Pantry/Dry Goods"
    },
    {
      "amount": "2 tbsp",
      "item": "Cajun seasoning",
      "store_section": "Pantry/Dry Goods"
    },
    {
      "amount": "4 cloves",
      "item": "garlic, minced",
      "store_section": "Produce"
    },
    {
      "amount": "1 cup",
      "item": "heavy cream",
      "store_section": "Dairy/Eggs"
    },
    {
      "amount": "1/2 cup",
      "item": "chicken broth",
      "store_section": "Pantry/Dry Goods"
    },
    {
      "amount": "1/2 cup",
      "item": "grated parmesan",
      "store_section": "Dairy/Eggs"
    },
    {
      "amount": "2 tbsp",
      "item": "butter",
      "store_section": "Dairy/Eggs"
    },
    {
      "amount": "2 tbsp",
      "item": "olive oil",
      "store_section": "Pantry/Dry Goods"
    },
    {
      "amount": "fresh",
      "item": "parsley for garnish",
      "store_section": "Produce"
    }
  ],
  "instructions": [
    "Cook pasta according to package directions. Reserve 1/2 cup pasta water before draining.",
    "Toss shrimp with Cajun seasoning.",
    "Heat olive oil in a large skillet over high heat. Cook shrimp 1-2 minutes per side. Remove.",
    "Reduce heat to medium. Melt butter and saute garlic 1 minute.",
    "Add cream and broth. Simmer 5 minutes until slightly reduced.",
    "Stir in parmesan until melted. Add pasta and toss, using pasta water to loosen if needed.",
    "Top with shrimp and parsley. Serve immediately."
  ],
  "substitutions": {
    "dairy_free": "Use coconut cream and nutritional yeast instead of cream and parmesan.",
    "gluten_free": "Use gluten-free pasta.",
    "low_carb": "Serve over zucchini noodles."
  }
}