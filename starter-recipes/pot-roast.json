{
  "name": "Pot Roast",
  "meal_type": "Dinner",
  "servings": 8,
  "prep_time": "20 minutes",
  "cook_time": "3 hours 30 minutes",
  "macros_per_serving": {
    "calories": 480,
    "protein_g": 42,
    "carbs_g": 22,
    "fat_g": 24
  },
  "ingredients": [
    {
      "amount": "4 lbs",
      "item": "chuck roast",
      "store_section": "Meat/Seafood"
    },
    {
      "amount": "4",
      "item": "large carrots, cut into chunks",
      "store_section": "Produce"
    },
    {
      "amount": "4",
      "item": "russet potatoes, quartered",
      "store_section": "Produce"
    },
    {
      "amount": "1 large",
      "item": "onion, quartered",
      "store_section": "Produce"
    },
    {
      "amount": "4 cloves",
      "item": "garlic, smashed",
      "store_section": "Produce"
    },
    {
      "amount": "2 cups",
      "item": "beef broth",
      "store_section": "Pantry/Dry Goods"
    },
    {
      "amount": "1/2 cup",
      "item": "red wine (optional)",
      "store_section": "Beverages"
    },
    {
      "amount": "2 tbsp",
      "item": "Worcestershire sauce",
      "store_section": "Pantry/Dry Goods"
    },
    {
      "amount": "2 sprigs",
      "item": "fresh rosemary",
      "store_section": "Produce"
    },
    {
      "amount": "2 sprigs",
      "item": "fresh thyme",
      "store_section": "Produce"
    },
    {
      "amount": "2 tbsp",
      "item": "vegetable oil",
      "store_section": "Pantry/Dry Goods"
    },
    {
      "amount": "to taste",
      "item": "salt and pepper",
      "store_section": "Pantry/Dry Goods"
    }
  ],
  "instructions": [
    "Preheat oven to 325\u00b0F. Pat roast dry and season heavily with salt and pepper.",
    "Heat oil in a Dutch oven over high heat. Sear roast 4 minutes per side until deep brown.",
    "Remove roast. Saute onion and garlic 3 minutes.",
    "Add broth, wine, and Worcestershire. Bring to a simmer, scraping up browned bits.",
    "Return roast. Add rosemary and thyme. Cover tightly.",
    "Braise in oven 2.5 hours. Add carrots and potatoes. Cook 1 more hour.",
    "Rest 15 minutes. Shred or slice and serve with braising liquid as gravy."
  ],
  "substitutions": {
    "gluten_free": "Already gluten-free.",
    "dairy_free": "Already dairy-free.",
    "low_carb": "Skip potatoes and serve with cauliflower mash."
  },
  "notes": "The deeper the sear, the richer the final flavor. Don't rush that step."
}