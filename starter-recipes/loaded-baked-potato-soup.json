{
  "name": "Loaded Baked Potato Soup",
  "meal_type": "Lunch",
  "servings": 6,
  "prep_time": "15 minutes",
  "cook_time": "30 minutes",
  "macros_per_serving": {
    "calories": 420,
    "protein_g": 14,
    "carbs_g": 48,
    "fat_g": 20
  },
  "ingredients": [
    {
      "amount": "6 large",
      "item": "russet potatoes, peeled and cubed",
      "store_section": "Produce"
    },
    {
      "amount": "6 strips",
      "item": "bacon, diced",
      "store_section": "Meat/Seafood"
    },
    {
      "amount": "1 large",
      "item": "onion, diced",
      "store_section": "Produce"
    },
    {
      "amount": "3 cloves",
      "item": "garlic, minced",
      "store_section": "Produce"
    },
    {
      "amount": "4 cups",
      "item": "chicken broth",
      "store_section": "Pantry/Dry Goods"
    },
    {
      "amount": "1 cup",
      "item": "sour cream",
      "store_section": "Dairy/Eggs"
    },
    {
      "amount": "1 cup",
      "item": "shredded cheddar cheese",
      "store_section": "Dairy/Eggs"
    },
    {
      "amount": "3 tbsp",
      "item": "butter",
      "store_section": "Dairy/Eggs"
    },
    {
      "amount": "3 tbsp",
      "item": "all-purpose flour",
      "store_section": "Pantry/Dry Goods"
    },
    {
      "amount": "2 cups",
      "item": "milk",
      "store_section": "Dairy/Eggs"
    },
    {
      "amount": "to taste",
      "item": "salt and pepper",
      "store_section": "Pantry/Dry Goods"
    }
  ],
  "instructions": [
    "Cook bacon in a large pot until crispy. Remove and set aside.",
    "Saute onion in drippings 5 minutes. Add garlic and cook 1 minute.",
    "Add butter and flour, stir 2 minutes. Whisk in broth and milk.",
    "Add potatoes. Simmer 20 minutes until very tender.",
    "Mash some potatoes against the side of the pot for a thick, chunky texture.",
    "Stir in sour cream and half the cheese. Season with salt and pepper.",
    "Top bowls with remaining cheese, bacon, and extra sour cream."
  ],
  "substitutions": {
    "dairy_free": "Use oat milk, dairy-free sour cream, and vegan cheese.",
    "gluten_free": "Replace flour with cornstarch (1.5 tbsp).",
    "vegetarian": "Skip bacon and use vegetable broth."
  }
}